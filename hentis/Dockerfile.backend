ARG UPSTREAM_BACKEND=makeplane/plane-backend:v1.4.2@sha256:90032ce088708889b60c00d491897916f4deb882facda27db59fd10fb68729ef
FROM ${UPSTREAM_BACKEND}
RUN pip install --no-cache-dir mistune==3.1.3 tzdata==2026.5
# Custom integration seams are merged against the same upstream release.
COPY apps/api/plane/custom_fields /code/plane/custom_fields
COPY apps/api/plane/ai /code/plane/ai
COPY apps/api/plane/celery.py /code/plane/celery.py
COPY apps/api/plane/settings/common.py /code/plane/settings/common.py
COPY apps/api/plane/app/urls/__init__.py /code/plane/app/urls/__init__.py
COPY apps/api/plane/app/serializers/issue.py /code/plane/app/serializers/issue.py
COPY apps/api/plane/app/views/issue/base.py /code/plane/app/views/issue/base.py
COPY apps/api/plane/api/serializers/issue.py /code/plane/api/serializers/issue.py
COPY apps/api/plane/db/models/issue.py /code/plane/db/models/issue.py
COPY apps/api/plane/db/migrations/0123_issue_schedule_times.py /code/plane/db/migrations/0123_issue_schedule_times.py
COPY apps/api/plane/utils/filters/filter_backend.py /code/plane/utils/filters/filter_backend.py
COPY apps/api/plane/utils/order_queryset.py /code/plane/utils/order_queryset.py
COPY apps/api/plane/utils/paginator.py /code/plane/utils/paginator.py
COPY apps/api/plane/utils/grouper.py /code/plane/utils/grouper.py
