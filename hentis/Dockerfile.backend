# syntax=docker/dockerfile:1
ARG UPSTREAM_BACKEND=makeplane/plane-backend:v1.4.2@sha256:90032ce088708889b60c00d491897916f4deb882facda27db59fd10fb68729ef
FROM ${UPSTREAM_BACKEND}
RUN pip install --no-cache-dir mistune==3.1.3 tzdata==2026.5
# Custom integration seams are merged against the same upstream release.
COPY apps/api/plane/custom_fields /code/plane/custom_fields
COPY apps/api/plane/ai /code/plane/ai
COPY apps/api/plane/celery.py /code/plane/celery.py
COPY apps/api/plane/settings/common.py /code/plane/settings/common.py
COPY apps/api/plane/app/urls/__init__.py /code/plane/app/urls/__init__.py
COPY apps/api/plane/app/urls/workspace.py /code/plane/app/urls/workspace.py
COPY apps/api/plane/app/serializers/issue.py /code/plane/app/serializers/issue.py
COPY apps/api/plane/app/serializers/personal_todo.py /code/plane/app/serializers/personal_todo.py
COPY apps/api/plane/app/views/issue/base.py /code/plane/app/views/issue/base.py
COPY apps/api/plane/app/views/workspace/personal_todo.py /code/plane/app/views/workspace/personal_todo.py
COPY apps/api/plane/app/views/workspace/user_preference.py /code/plane/app/views/workspace/user_preference.py
COPY apps/api/plane/api/serializers/issue.py /code/plane/api/serializers/issue.py
COPY apps/api/plane/api/urls/__init__.py /code/plane/api/urls/__init__.py
COPY apps/api/plane/api/urls/report_read.py /code/plane/api/urls/report_read.py
COPY apps/api/plane/api/views/report_read.py /code/plane/api/views/report_read.py
COPY apps/api/plane/db/models/__init__.py /code/plane/db/models/__init__.py
COPY apps/api/plane/db/models/issue.py /code/plane/db/models/issue.py
COPY apps/api/plane/db/models/personal_todo.py /code/plane/db/models/personal_todo.py
COPY apps/api/plane/db/models/workspace.py /code/plane/db/models/workspace.py
COPY apps/api/plane/db/migrations/0123_issue_schedule_times.py /code/plane/db/migrations/0123_issue_schedule_times.py
COPY apps/api/plane/db/migrations/0124_personal_todo.py /code/plane/db/migrations/0124_personal_todo.py
COPY apps/api/plane/db/migrations/0125_personal_todo_linked_issue.py /code/plane/db/migrations/0125_personal_todo_linked_issue.py
COPY apps/api/plane/db/migrations/0126_personal_todo_linked_issues.py /code/plane/db/migrations/0126_personal_todo_linked_issues.py
COPY apps/api/plane/db/migrations/0127_remove_personal_todo_linked_issue.py /code/plane/db/migrations/0127_remove_personal_todo_linked_issue.py
COPY apps/api/plane/utils/filters/filter_backend.py /code/plane/utils/filters/filter_backend.py
COPY apps/api/plane/utils/order_queryset.py /code/plane/utils/order_queryset.py
COPY apps/api/plane/utils/paginator.py /code/plane/utils/paginator.py
COPY apps/api/plane/utils/grouper.py /code/plane/utils/grouper.py

# Fail the build if a To-do route, model or migration was omitted from the image.
RUN --network=none --mount=type=bind,source=hentis/verify-backend-image.py,target=/tmp/verify-backend-image.py \
    DJANGO_SETTINGS_MODULE=plane.settings.production REDIS_URL=redis://127.0.0.1:6379/0 \
    python - < /tmp/verify-backend-image.py
