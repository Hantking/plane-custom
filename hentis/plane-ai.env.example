# Apply to API, worker, beat-worker and migrator. No real secrets in this file.
PLANE_AI_ENABLED=0
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PLANE_AI_ENCRYPTION_KEY=
# Exact hostnames only, comma-separated, without scheme/path. No wildcard.
PLANE_AI_ALLOWED_HOSTS=
# Local/private endpoints require this explicit setting AND the hostname allowlist.
PLANE_AI_ALLOW_PRIVATE_ENDPOINTS=0
